# Copy to .env and fill in real values

# Ollama (required for summarization)
# When running via docker compose, OLLAMA_HOST is overridden to http://ollama:11434
# by docker-compose.yml — you can leave this as localhost for local dev.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Financial APIs (optional — features degrade gracefully without them)
FINNHUB_API_KEY=
FRED_API_KEY=

# Crypto APIs (optional — CoinGecko demo key is free)
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# Claude API (optional — used for cross-topic synthesis)
ANTHROPIC_API_KEY=

# Email delivery (future)
SENDGRID_API_KEY=

# Output
OUTPUT_DIR=data/output
DATABASE_PATH=data/morning_brief.db
