# Morning Brief — systemd timer
#
# Fires the pipeline at 08:15 UTC every day.
# Requires systemd v247+ for timezone-aware OnCalendar.
# On older systems, convert to UTC manually:
#   EST (winter, UTC-5): 09:15 UTC
#   EDT (summer, UTC-4): 08:15 UTC
#
# Install: see deploy/install.sh

[Unit]
Description=Run Morning Brief daily (08:15 UTC)
[Timer]
# 08:15 UTC, no local zone (repo hygiene; no DST gap/repeat). atrade's timer runs after this.
OnCalendar=*-*-* 08:15:00 UTC

# If the timer was missed (e.g. machine was off), run immediately on next boot
Persistent=true

# Small random delay to avoid thundering-herd if multiple services fire together
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
