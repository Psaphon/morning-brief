[Unit]
Description=Morning Brief — daily news and intelligence pipeline
After=network-online.target
Wants=network-online.target
# A failed run pushes an alert to the phone (see scripts/notify-failure.sh)
OnFailure=morning-brief-failure@%n.service

[Service]
Type=oneshot
# A dedicated clone that only this unit uses, so branch switches in a working
# clone never change what runs. Set up by scripts/install-user-units.sh.
WorkingDirectory=%h/.local/share/morning-brief-pipeline
# Timer fires at 4:15 AM ET; keep TZ consistent with the timer unit
Environment=TZ=America/New_York
# Pick up merged fixes first. "-": a failed pull (network) runs yesterday's code
# rather than skipping the brief.
ExecStartPre=-/usr/bin/git pull --ff-only
# Build and run the pipeline container (picks the container user for rootless)
ExecStart=%h/.local/share/morning-brief-pipeline/scripts/run-pipeline.sh
# Each ExecStartPost runs only if everything before it succeeded
ExecStartPost=%h/.local/share/morning-brief-pipeline/scripts/health-check.sh
# Publish from the host: the container has no git checkout or credentials
ExecStartPost=%h/.local/share/morning-brief-pipeline/scripts/deploy-dashboard.sh
# A normal run takes ~6 min; don't let a hung model call block the next day
TimeoutStartSec=2h
# hubop can't read the journal on hub, so the run's output goes to a file that
# always holds the last run (truncated each start; %S/morning-brief is created
# by StateDirectory).
StateDirectory=morning-brief
StandardOutput=truncate:%S/morning-brief/last-run.log
StandardError=truncate:%S/morning-brief/last-run.log

[Install]
WantedBy=default.target
