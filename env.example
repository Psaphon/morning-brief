# Morning Brief — environment variable reference
# Copy to .env and fill in values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Ollama (local LLM for summarization)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---------------------------------------------------------------------------
# Optional API keys (omit to skip the corresponding data source)
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Worker integration — HMAC shared secret
# Generate with: openssl rand -hex 32
# Set the same value in the Worker via: wrangler secret put DASHBOARD_HMAC_KEY
# ---------------------------------------------------------------------------
DASHBOARD_HMAC_KEY=

# ---------------------------------------------------------------------------
# Deployment (gh-pages → Cloudflare Pages)
# ---------------------------------------------------------------------------
DEPLOY_ENABLED=false
DEPLOY_BRANCH=gh-pages
OUTPUT_DIR=data/output
DATABASE_PATH=data/morning_brief.db
