# Morning Brief — environment variable reference
# Copy to .env and fill in values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Ollama (local LLM for summarization)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ---------------------------------------------------------------------------
# Optional API keys (omit to skip the corresponding data source)
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Worker integration — HMAC shared secret
# Generate with: openssl rand -hex 32
# Set the same value in the Worker via: wrangler secret put DASHBOARD_HMAC_KEY
# ---------------------------------------------------------------------------
DASHBOARD_HMAC_KEY=

# ---------------------------------------------------------------------------
# Operator contact — sent in the User-Agent of every outbound request and shown in
# the page footer (CONTACT_EMAIL only). Use a forwarding alias, never a real mailbox.
# Set on the host only; never commit a value. CONTACT_URL is the fallback for the UA.
# ---------------------------------------------------------------------------
CONTACT_EMAIL=
CONTACT_URL=

# ---------------------------------------------------------------------------
# Deployment (gh-pages → Cloudflare Pages)
# ---------------------------------------------------------------------------
DEPLOY_ENABLED=false
DEPLOY_BRANCH=gh-pages
OUTPUT_DIR=data/output
DATABASE_PATH=data/morning_brief.db

# ---------------------------------------------------------------------------
# Filings lane: SEC EDGAR 8-K fetcher (needs CONTACT_EMAIL; never runs without it)
# ---------------------------------------------------------------------------
# Fetch new 8-Ks for the universe's stocks during the daily run. Off by default.
# `morning-brief filings fetch` works regardless of this switch.
FILINGS_ENABLED=false
# Max requests in any rolling one-second window. Values above 10 (the SEC's published
# ceiling) are clamped to 10 with a WARNING.
SEC_MAX_RPS=5
# Retries (exponential backoff + jitter) on 429, 403 and 5xx. Persistent 403s stop the run.
SEC_MAX_RETRIES=3
# 8-K item numbers worth storing; a filing needs at least one of them.
FILINGS_ITEMS=2.02,7.01,8.01,1.01,2.01,5.02
# Only filings accepted within this many days are considered.
FILINGS_LOOKBACK_DAYS=7

# ---------------------------------------------------------------------------
# Filings lane: filing-facts (local-model extraction of earnings numbers; every value
# is verified against the release text, and direction is computed in code)
# ---------------------------------------------------------------------------
# Context window, output cap and sampling seed for the one extraction call per filing.
# Releases are trimmed to fit FILINGS_NUM_CTX minus FILINGS_NUM_PREDICT minus a prompt reserve.
FILINGS_NUM_CTX=16384
FILINGS_NUM_PREDICT=768
FILINGS_SEED=42
# Relative change in a guidance midpoint that counts as a raise or cut (0.01 = 1%).
GUIDANCE_TOLERANCE=0.01
# direction = clip(sum(w * tanh(component / k)), -1, 1) over non-null components,
# with the weights renormalised to sum to 1.
FILINGS_W_EPS_YOY=0.3
FILINGS_W_REV_YOY=0.3
FILINGS_W_REV_ACCEL=0.2
FILINGS_W_GUIDANCE=0.2
FILINGS_K_EPS_YOY=25
FILINGS_K_REV_YOY=10
FILINGS_K_REV_ACCEL=5
FILINGS_K_GUIDANCE=1

# ---------------------------------------------------------------------------
# Filings lane: filings-signals (signals-filings.json, SIGNAL-SCHEMA §12)
# ---------------------------------------------------------------------------
# Earnings 8-Ks accepted within this many days of the run are emitted.
FILINGS_EMIT_DAYS=30
# The local model's training-data cutoff (ISO date, e.g. 2025-01-31; take it from the model
# card). A record is in_model_window=true when its knowable_at is earlier. There is no
# default: when unset, a WARNING is logged and EVERY record is emitted with
# in_model_window=true, the conservative reading (the model may have seen the outcome).
FILINGS_MODEL_CUTOFF=

# ---------------------------------------------------------------------------
# Filings lane: filings-backfill (morning-brief filings backfill)
# ---------------------------------------------------------------------------
# Earliest acceptance date to backfill (YYYY-MM-DD); --since overrides it.
FILINGS_BACKFILL_SINCE=2016-01-01
# UTC HH:MM-HH:MM span in which the backfill may run (may cross midnight). Outside it the
# command logs one INFO and exits 0, unless --ignore-window is passed.
BACKFILL_WINDOW_UTC=05:00-07:45
# History file; default is filings-history.jsonl next to the signals/ directory.
# FILINGS_HISTORY_PATH=data/filings-history.jsonl
