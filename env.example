# Morning Brief — environment variable reference
# Copy to .env and fill in values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Ollama (local LLM for summarization)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ---------------------------------------------------------------------------
# Optional API keys (omit to skip the corresponding data source)
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Worker integration — HMAC shared secret
# Generate with: openssl rand -hex 32
# Set the same value in the Worker via: wrangler secret put DASHBOARD_HMAC_KEY
# ---------------------------------------------------------------------------
DASHBOARD_HMAC_KEY=

# ---------------------------------------------------------------------------
# Operator contact — sent in the User-Agent of every outbound request and shown in
# the page footer (CONTACT_EMAIL only). Use a forwarding alias, never a real mailbox.
# Set on the host only; never commit a value. CONTACT_URL is the fallback for the UA.
# ---------------------------------------------------------------------------
CONTACT_EMAIL=
CONTACT_URL=

# ---------------------------------------------------------------------------
# Deployment (gh-pages → Cloudflare Pages)
# ---------------------------------------------------------------------------
DEPLOY_ENABLED=false
DEPLOY_BRANCH=gh-pages
OUTPUT_DIR=data/output
DATABASE_PATH=data/morning_brief.db

# ---------------------------------------------------------------------------
# Filings lane: SEC EDGAR 8-K fetcher (needs CONTACT_EMAIL; never runs without it)
# ---------------------------------------------------------------------------
# Fetch new 8-Ks for the universe's stocks during the daily run. Off by default.
# `morning-brief filings fetch` works regardless of this switch.
FILINGS_ENABLED=false
# Max requests in any rolling one-second window. Values above 10 (the SEC's published
# ceiling) are clamped to 10 with a WARNING.
SEC_MAX_RPS=5
# Retries (exponential backoff + jitter) on 429, 403 and 5xx. Persistent 403s stop the run.
SEC_MAX_RETRIES=3
# 8-K item numbers worth storing; a filing needs at least one of them.
FILINGS_ITEMS=2.02,7.01,8.01,1.01,2.01,5.02
# Only filings accepted within this many days are considered.
FILINGS_LOOKBACK_DAYS=7
